rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pilot workshop: signed-in participants may contribute, but not edit others' work.
    // These rules must be reviewed and tested before public participation.
    match /workshops/{workshopId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /nodes/{nodeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['label','detail','type','createdBy','createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 100
          && request.resource.data.detail is string
          && request.resource.data.detail.size() <= 2000
          && request.resource.data.type in ['transformation','condition','implication','response']
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /edges/{edgeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['from','to','createdBy','createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
